<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GitPa</RootNamespace>
    <AssemblyName>git-pa</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>git-pa</ToolCommandName>
    <PackageId>GitPa</PackageId>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Stay on your dev branch: create feature branches from main and commit to them without switching. A git helper for Power Apps plugin teams sharing one dev environment.</Description>
    <Authors>Chhay Sophal</Authors>
    <Copyright>Copyright (c) 2026 Chhay Sophal</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chhay-sophal/git-pa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chhay-sophal/git-pa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>git;power-apps;power-platform;dataverse;dynamics-365;plugins;cli;git-workflow</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
